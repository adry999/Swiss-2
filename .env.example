# PostgreSQL
DATABASE_URL=postgres://swisscars:swisscars@localhost:5432/swisscars

# Session encryption (nuxt-auth-utils) — generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-32+-char-random-string

# Cloudflare R2 (S3-compatible) image storage
NUXT_R2_ACCOUNT_ID=
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
NUXT_R2_BUCKET=swisscars-photos
# Public base URL for serving uploaded images (R2 public bucket / custom domain)
NUXT_PUBLIC_IMAGE_BASE_URL=

# Public site URL (SEO: canonical, sitemap, OG)
NUXT_PUBLIC_SITE_URL=https://swisscars.md
